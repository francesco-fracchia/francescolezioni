# Copy values to hPanel (Business/Cloud) or to a private EnvironmentFile (VPS).
# No real credentials are distributed in this file.
APP_RUNTIME=node
NODE_ENV=production
SITE_ORIGIN=https://DOMINIO-DA-SCEGLIERE.it
# Must be an absolute, private, persistent directory OUTSIDE the deployed app.
# VPS example below. On Business/Cloud, ask Hostinger to confirm a writable
# persistent path outside public_html and hbuilds BEFORE enabling the app.
APP_DATA_DIR=/var/lib/ff-lessons
SITE_VISIBILITY=private
PUBLIC_SITE_INDEXING=false
NOTIFICATIONS_MODE=preview
PAYMENT_LIVE_ENABLED=0
BOOKING_SCHEDULE_ENABLED=1
PORT=3000
HOSTINGER_BIND_ADDRESS=127.0.0.1
# For managed hosting with an externally routed app, use 0.0.0.0 instead.
# Explicit deployment migration opt-in. Back up an existing DB before enabling.
HOSTINGER_AUTO_MIGRATE=0
# Only on the FIRST deployment of a NEW database; then remove both variables.
HOSTINGER_BOOTSTRAP_EMAIL=
HOSTINGER_BOOTSTRAP_PASSWORD=
# Real email/Stripe credentials intentionally absent. Existing test settings
# should be added manually only when you want to test those integrations.
