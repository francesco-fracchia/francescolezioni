# Configurare nel progetto Vercel. Nessuna credenziale va salvata nel repository.
# Lasciare 0 finché migrazioni, account tutor, file e flussi remoti non sono collaudati.
VERCEL_RUNTIME_READY=0
SITE_VISIBILITY=private
PUBLIC_SITE_INDEXING=false
NOTIFICATIONS_MODE=preview
PAYMENT_LIVE_ENABLED=0
# Attivare solo dopo aver collegato e verificato PayPal nel dashboard Stripe.
STRIPE_PAYPAL_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_SCHEDULE_ENABLED=1
# Impostare l'origine HTTPS reale dopo la scelta del dominio.
SITE_ORIGIN=https://lezionifrancesco.app
# Database Turso DEDICATO. Entrambe le variabili sono segreti server.
# Non collegare un database condiviso con altre applicazioni.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob PRIVATE, collegato solo a Production. OIDC fornito da Vercel.
# Nessuna chiave di lettura/scrittura persistente è necessaria.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# D1 è un'alternativa, da lasciare vuota quando si usa Turso.
# Database D1 remoto e bucket R2 privato nell'account Cloudflare del titolare.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Anteprima privata del sito pubblico, senza accesso ai dati o alle API.
# Password riservata di almeno 20 caratteri; usare valori distinti per Production/Preview.
SITE_PREVIEW_PASSWORD=

# Chiave stabile per cifrare i collegamenti calendario: 32 byte, 64 caratteri hex.
# Segreto solo server, distinto per ambiente; conservarne una copia riservata.
CALENDAR_CONNECTION_KEY=
